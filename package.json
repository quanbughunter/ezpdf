{
  "name": "ezpdf",
  "private": true,
  "version": "0.5.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json && vite build",
    "build:desktop": "tsc -p tsconfig.json && vite build --mode desktop",
    "build:android": "tsc -p tsconfig.json && vite build --mode android && cap sync android",
    "preview": "vite preview",
    "tauri": "tauri",
    "cap": "cap",
    "typecheck": "tsc -p tsconfig.json",
    "test:layout": "tsx tests/text-layout.test.ts",
    "test:engine": "tsx tests/engine-proof.ts",
    "verify": "for f in sample sample-aes256-owner sample-rc4-owner; do python3 scripts/verify_export.py out/$f/final.pdf out/$f/expected.json || exit 1; done",
    "test:m3": "tsx tests/m3-engine-probe.ts && python3 scripts/verify_images.py out/m3/expected.json",
    "e2e": "node scripts/e2e.cjs",
    "e2e:preview": "BASE=http://localhost:4173 SKIP_PDFJS=1 node scripts/e2e.cjs",
    "e2e:m3": "node scripts/e2e-m3.cjs",
    "e2e:m3:preview": "BASE=http://localhost:4173 SKIP_PDFJS=1 node scripts/e2e-m3.cjs",
    "e2e:all": "node scripts/e2e.cjs && node scripts/e2e-m3.cjs && node scripts/e2e-m4.cjs && node scripts/e2e-edit.cjs && node scripts/e2e-scan.cjs",
    "fixtures": "python3 scripts/make_fixture.py tests/fixtures/sample.pdf && python3 scripts/make_long_fixture.py tests/fixtures/long-300.pdf && python3 scripts/make_image_fixtures.py tests/fixtures && node scripts/make_edit_fixture.cjs && python3 scripts/make_scan_fixtures.py tests/fixtures/scan",
    "test:storage": "tsx tests/storage.test.ts",
    "e2e:m4": "node scripts/e2e-m4.cjs",
    "icons": "node scripts/make_icons.cjs && tauri icon branding/icon-1024.png -o src-tauri/icons",
    "e2e:m4:preview": "BASE=http://localhost:4173 node scripts/e2e-m4.cjs",
    "test:edit": "tsx tests/text-edit-probe.ts && python3 scripts/verify_text_edit.py out/text-edit/expected.json",
    "e2e:edit": "node scripts/e2e-edit.cjs",
    "e2e:edit:preview": "BASE=http://localhost:4173 node scripts/e2e-edit.cjs",
    "e2e:scan": "node scripts/e2e-scan.cjs",
    "e2e:scan:preview": "BASE=http://localhost:4173 node scripts/e2e-scan.cjs"
  },
  "dependencies": {
    "@capacitor/android": "8.5.3",
    "@capacitor/core": "8.5.3",
    "@capacitor/filesystem": "8.1.4",
    "@embedpdf/core": "2.15.1",
    "@embedpdf/engines": "2.15.1",
    "@embedpdf/models": "2.15.1",
    "@embedpdf/pdfium": "2.15.1",
    "@embedpdf/plugin-annotation": "2.15.1",
    "@embedpdf/plugin-document-manager": "2.15.1",
    "@embedpdf/plugin-export": "2.15.1",
    "@embedpdf/plugin-history": "2.15.1",
    "@embedpdf/plugin-interaction-manager": "2.15.1",
    "@embedpdf/plugin-render": "2.15.1",
    "@embedpdf/plugin-rotate": "2.15.1",
    "@embedpdf/plugin-scroll": "2.15.1",
    "@embedpdf/plugin-search": "2.15.1",
    "@embedpdf/plugin-selection": "2.15.1",
    "@embedpdf/plugin-thumbnail": "2.15.1",
    "@embedpdf/plugin-tiling": "2.15.1",
    "@embedpdf/plugin-viewport": "2.15.1",
    "@embedpdf/plugin-zoom": "2.15.1",
    "@tauri-apps/api": "2.12.4",
    "@tauri-apps/plugin-dialog": "2.8.3",
    "@tauri-apps/plugin-fs": "2.7.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.63.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.3",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "2.12.4",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "pdfjs-dist": "6.4.299",
    "playwright": "1.63.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^8.3.5"
  }
}
