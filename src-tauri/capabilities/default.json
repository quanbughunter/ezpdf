{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "ezPDF main window: open/save dialogs, files the user picked, and the app's own store folder. Nothing else on disk, no network.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-destroy",
    "dialog:allow-open",
    "dialog:allow-save",
    "fs:allow-exists",
    "fs:allow-read-file",
    "fs:allow-read-text-file",
    "fs:allow-write-file",
    "fs:allow-write-text-file",
    "fs:allow-read-dir",
    "fs:allow-mkdir",
    "fs:allow-remove",
    {
      "identifier": "fs:scope",
      "allow": [{ "path": "$APPLOCALDATA/store" }, { "path": "$APPLOCALDATA/store/**" }]
    }
  ]
}
