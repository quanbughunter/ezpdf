{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "ezPDF",
  "version": "0.8.0",
  "identifier": "app.ezpdf.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build:desktop"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ezPDF",
        "width": 1280,
        "height": 840,
        "minWidth": 360,
        "minHeight": 480,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; script-src 'self' 'wasm-unsafe-eval'; worker-src 'self' blob:; connect-src 'self' ipc: http://ipc.localhost blob: data:; img-src 'self' blob: data:; style-src 'self' 'unsafe-inline'; font-src 'self' blob: data:; object-src 'none'; base-uri 'self'; form-action 'none'",
      "dangerousDisableAssetCspModification": ["style-src"]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "ezPDF",
    "category": "Productivity",
    "shortDescription": "Read, annotate, sign and export PDFs on this device",
    "longDescription": "ezPDF opens PDF files on this device to annotate, highlight, add Vietnamese text, insert pictures, sign, rotate pages and export a new PDF. Documents never leave the device.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "fileAssociations": [
      {
        "ext": ["pdf"],
        "name": "PDF",
        "description": "PDF document",
        "mimeType": "application/pdf",
        "role": "Editor",
        "rank": "Alternate"
      },
      {
        "ext": ["docx"],
        "name": "Word",
        "description": "Word document",
        "mimeType": "application/vnd.openxmlformats-officedocument.wordprocessingml.document",
        "role": "Editor",
        "rank": "Alternate"
      }
    ],
    "windows": {
      "nsis": { "installMode": "currentUser" }
    }
  }
}
